code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform sampler2D tex_frg_9;
uniform sampler2D tex_frg_2;



void fragment() {
// UVFunc:8
	vec2 n_in8p1 = vec2(0.00000, 2.00000);
	vec2 n_in8p2 = vec2(0.00000, 0.00000);
	vec2 n_out8p0 = (UV - n_in8p2) * n_in8p1 + n_in8p2;
	float n_out8p2 = n_out8p0.g;


// Texture2D:9
	vec4 n_out9p0 = texture(tex_frg_9, vec2(n_out8p2));


// UVFunc:4
	vec2 n_in4p1 = vec2(3.00000, 0.00000);
	vec2 n_in4p2 = vec2(0.00000, 0.00000);
	vec2 n_out4p0 = (UV - n_in4p2) * n_in4p1 + n_in4p2;
	float n_out4p1 = n_out4p0.r;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out4p0);


	vec3 n_out10p0;
// ColorOp:10
	{
		float base = vec3(n_out9p0.xyz).x;
		float blend = vec3(n_out2p0.xyz).x;
		if (base < 0.5) {
			n_out10p0.x = 2.0 * base * blend;
		} else {
			n_out10p0.x = 1.0 - 2.0 * (1.0 - blend) * (1.0 - base);
		}
	}
	{
		float base = vec3(n_out9p0.xyz).y;
		float blend = vec3(n_out2p0.xyz).y;
		if (base < 0.5) {
			n_out10p0.y = 2.0 * base * blend;
		} else {
			n_out10p0.y = 1.0 - 2.0 * (1.0 - blend) * (1.0 - base);
		}
	}
	{
		float base = vec3(n_out9p0.xyz).z;
		float blend = vec3(n_out2p0.xyz).z;
		if (base < 0.5) {
			n_out10p0.z = 2.0 * base * blend;
		} else {
			n_out10p0.z = 1.0 - 2.0 * (1.0 - blend) * (1.0 - base);
		}
	}


	vec3 n_out11p0;
// ColorFunc:11
	{
		vec3 c = n_out10p0;
		n_out11p0 = mix(pow((c.rgb + vec3(0.055)) * (1.0 / (1.0 + 0.055)), vec3(2.4)), c.rgb * (1.0 / 12.92), lessThan(c.rgb, vec3(0.04045)));
	}


// Input:17
	vec2 n_out17p0 = UV;
	float n_out17p2 = n_out17p0.g;


// FloatFunc:13
	float n_out13p0 = round(n_out17p2);


// FloatFunc:14
	float n_out14p0 = 1.0 - n_out13p0;


// VectorOp:15
	vec3 n_out15p0 = n_out11p0 * vec3(n_out14p0);


// Compare:20
	float n_in20p1 = 0.50000;
	bool n_out20p0 = n_out8p2 < n_in20p1;


// Compare:19
	float n_in19p1 = 0.90000;
	bool n_out19p0 = n_out4p1 > n_in19p1;


// Mix:18
	vec3 n_out18p0 = mix(n_out15p0, vec3(n_out20p0 ? 1.0 : 0.0), (n_out19p0 ? 1.0 : 0.0));


// Output:0
	ALBEDO = n_out18p0;


}
"
